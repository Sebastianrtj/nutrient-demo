{
  "name": "nutrient-ridgeline-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1 --port 8768 --strictPort",
    "prepare:sdk": "node scripts/prepare-sdk.mjs",
    "postinstall": "npm run prepare:sdk",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test server/*.test.ts src/components/*.test.tsx src/lib/*.test.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "build:hosted": "node --import tsx scripts/build-hosted.mjs",
    "test:worker": "node --import tsx --test worker/*.test.mjs",
    "prebuild": "node scripts/prepare-proof-recordings.mjs",
    "prebuild:hosted": "node scripts/prepare-proof-recordings.mjs"
  },
  "dependencies": {
    "@nutrient-sdk/viewer": "1.24.0",
    "archiver": "8.0.0",
    "csv-parse": "7.0.3",
    "express": "5.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "1.62.0",
    "pdf-lib": "1.17.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/archiver": "8.0.0",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "esbuild": "^0.28.2",
    "playwright": "1.62.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "^4.154.0"
  }
}
